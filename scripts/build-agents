#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

command -v cargo-zigbuild >/dev/null 2>&1 || {
  echo "cargo-zigbuild is required: cargo install cargo-zigbuild --locked" >&2
  exit 1
}
command -v zig >/dev/null 2>&1 || {
  echo "zig is required" >&2
  exit 1
}

rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl
cargo zigbuild --release --bin devsync-agent \
  --target x86_64-unknown-linux-musl \
  --target aarch64-unknown-linux-musl

mkdir -p bin
for tuple in linux-x86_64 linux-aarch64; do
  case "$tuple" in
    linux-x86_64) target=x86_64-unknown-linux-musl ;;
    linux-aarch64) target=aarch64-unknown-linux-musl ;;
  esac
  cp "target/$target/release/devsync-agent" "bin/devsync-agent-$tuple.new"
  mv -f "bin/devsync-agent-$tuple.new" "bin/devsync-agent-$tuple"
done
